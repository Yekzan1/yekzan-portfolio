# ----------------------------------------------------------------------------
# Yekzan KUS — Portfolio · environment variables
# Copy this file to `.env.local` (for local dev) and fill in what you need.
# Every variable below is OPTIONAL — the site runs fully without any of them.
# ----------------------------------------------------------------------------

# Public site URL. Used for SEO canonical/alternate links, the sitemap and
# Open Graph images. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://yekzan-portfolio.vercel.app

# --- AI assistant (optional) -------------------------------------------------
# Leave EMPTY to use the free, offline, zero-cost assistant (recommended).
# Provide an Anthropic API key to upgrade the assistant to Claude. The system
# prompt is locked to the CV/recommendations so it never invents facts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
